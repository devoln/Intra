# Local build output and analysis scripts (not tracked)
#
# `web/` only carries hand-written source for the player
# (web/index.html, web/synth.js). Every artifact produced by the build
# pipeline lives in `web/generated/` (intra build wasm + js loaders) so
# `web/*.wasm` cannot accidentally be re-tracked. The final assembled
# deploy bundle lives in `dist/`.
#
# See docs/decisions/active/20260820-WebBuildArtifactsLayout.md.
#
/scripts/
/web/generated/
/dist/

# Temporary experiment output (build trees, probes, scratch) — never tracked.
# Ad-hoc build trees and probe artifacts must live under .scratch/ or be
# gitignored; see AGENTS.md.
/.scratch/
/build-*/
/probe-tmp/
